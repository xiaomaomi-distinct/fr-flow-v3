<?xml version="1.0" encoding="UTF-8"?>
<WorkBook xmlVersion="20211223" releaseVersion="11.5.0">
<ReportWebAttr>
<ServerPrinter/>
<WebWriteContent>
<Listener event="afterload">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[
/* ================================================================
   展示层 CPT 的 afterload <Content> 由以下三段构成：

   ┌──────────────────────────┬──────────────────────┬────────┐
   │  PREAMBLE（固定，由 writer │  DEVELOPER ZONE      │POSTAMB.│
   │   自动写入，你不需要管）   │  ← .mjs 内容填到这里  │});    │
   │  function(){ 'use strict' │  纯业务 JS，无需包裹  │        │
   │  PATH = {...};           │                       │        │
   │  帆软框架隐藏 ...          │                       │        │
   └──────────────────────────┴──────────────────────┴────────┘
   用途说明：本文件仅供预览最终 JS 结构，勿直接修改。
   实际发布时请在 .mjs 文件中编写上方的"DEVELOPER ZONE"内容，
   然后运行 display_writer.py 发布。
================================================================ */

(function() {
    'use strict';

/* ===== PREAMBLE（帆软固定结构，勿删勿改） ===== */
    // 加载 antd 样式（内网环境）
    var antdCSS = document.createElement('link');
    antdCSS.rel = 'stylesheet';
    antdCSS.href = '/webroot/help/lib/antd/antd.min.css';
    document.head.appendChild(antdCSS);

    var PATH = {
        currentDir: (function() {
            var name = FR.remoteEvaluate("=reportName");
            return name.substring(0, name.lastIndexOf('/') + 1);
        })(),
        apiBase: (function() {
            var servletURL = FR.remoteEvaluate("=servletURL");
            var parts = servletURL.split('/');
            return '/' + parts[1] + '/' + parts[2];
        })(),
        getDataTemplate: function(filename) {
            return this.currentDir.replace('/pages/', '/data/') + filename;
        },
        getTemplatePath: function(filename) {
            return this.currentDir + filename;
        }
    };

    var hideStyle = document.createElement('style');
    hideStyle.innerHTML =
        '.fr-report{position:absolute!important;left:-9999px!important;visibility:hidden!important}' +
        'body>.textbox-container,body>#textboxContainer,body>.widget-container{display:none!important}';
    document.head.appendChild(hideStyle);
    document.body.setAttribute('style',
        'margin:0;padding:0;min-height:100vh;box-sizing:border-box;overflow-y:auto;');

/* ===== DEVELOPER ZONE（display_writer.py 会把 .mjs 的内容整体填入这里） =====
   此区内容仅供参考，最终 CPT 由 writer 自动生成，勿手动编辑本文件。
   开发者 .mjs 最低限度写法示例（共 5 行，即是一个完整可运行的页面）：
   ----------------------------------------------------------
   var App = function() {
       var _s = antd.useState;
       return React.createElement('div', {className:'page-list'},
           React.createElement(antd.Input, {placeholder:'搜索', onChange:function(e){_s[1](e.target.value);}}),
           React.createElement(antd.Button, {type:'primary', onClick:function(){alert(_s[0]);}}, '搜索')
       );
   };
   ReactDOM.createRoot(document.getElementById('app-root')).render(React.createElement(App, null));
   ----------------------------------------------------------
   更多示例、已知限制及完整 antd 用法：shared/KNOWLEDGE/ANTD_REACT_GUIDE.md
===========================================================================*/

/* ===== POSTAMBLE（帆软固定结构，勿删勿改） ===== */
});
]]></Content>
</JavaScript>
</Listener>
