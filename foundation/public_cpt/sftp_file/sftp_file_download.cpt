<Highlight class="com.fr.report.cell.cellattr.highlight.DefaultHighlight">
<Name>
<![CDATA[全部下载链接]]></Name>
<Condition class="com.fr.data.condition.FormulaCondition">
<Formula>
<![CDATA[count(D3) > 0]]></Formula>
</Condition>
<HighlightAction class="com.fr.report.cell.cellattr.highlight.HyperlinkHighlightAction">
<NameJavaScriptGroup>
<NameJavaScript name="JavaScript脚本2">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="urlArray"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=K3]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="fileNameArray"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=D3]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="fileSourceArray"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=L3]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="zipName"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$fine_username + FORMAT(NOW(), "yyyyMMddHHmmss")]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[// 写下载日志
_g().setCellValue(16, 1, "2");
_g().setCellValue(17, 1, "");
setTimeout(() => {
	_g().verifyAndWriteReport();
}, 100);

// 过滤文件来源
let fileSourceFilter = (ele,index) => {
    return fileSourceArray[index]A === "1"
}
urlArray = []A.concat(urlArray).filter(fileSourceFilter)
fileNameArray = []A.concat(fileNameArray).filter(fileSourceFilter)
//urlArray = urlArray.filter(fileSourceFilter)
//fileNameArray = fileNameArray.filter(fileSourceFilter)

// 打包下载
myFR.attachment.downloadBatch(urlArray, fileNameArray, zipName);]]></Content>
</JavaScript>
</NameJavaScript>
</NameJavaScriptGroup>
