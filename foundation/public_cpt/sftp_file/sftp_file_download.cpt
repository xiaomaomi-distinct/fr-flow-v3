<?xml version="1.0" encoding="UTF-8"?>
<WorkBook xmlVersion="20211223" releaseVersion="11.0.0">
<TableDataMap>
<TableData name="main_qry" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="file_path_uuid"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[common_db]]></DatabaseName>
</Connection>
<Query>
<![CDATA[select a.id, a.file_path_uuid, a.file_dir, a.file_url, a.file_name, a.relative_path, a.file_source, a.operator_oa,
       a.create_time, a.update_time, a.remark
  from ftp_file_record a
 where a.file_path_uuid = '${file_path_uuid}'
   and a.curr_status = '1'
 order by a.update_time asc;]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
<ReportWebAttr>
<ServerPrinter/>
<WebPageContent>
<ToolBars/>
<WebPage isPage="false" showAsImage="false" autoScale="false" tdHeavy="false" pageFixedRow="false" pageFixedRowCount="30"/>
</WebPageContent>
<WebWriteContent>
<Listener event="startload">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="file_path_uuid"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$file_path_uuid]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="busi_path"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$busi_path]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[if (file_path_uuid.length == 0 || typeof(file_path_uuid) == 'undefined') {
	window.parent.FR.Msg.alert("提示", "文件关联id为空，请联系信息科技部！");
	window.parent.FR.closeDialog();
	return false;
}
]]></Content>
</JavaScript>
</Listener>
<Listener event="afterwrite">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[if (fr_submitinfo.success) {
	setTimeout(() => {
		_g().parameterCommit();
	}, 500);
	return false;
} else {
	window.parent.FR.Msg.alert("错误", fr_submitinfo.failinfo);
}]]></Content>
</JavaScript>
</Listener>
