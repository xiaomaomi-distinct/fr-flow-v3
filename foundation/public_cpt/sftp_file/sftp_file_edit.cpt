<NameJavaScriptGroup>
<NameJavaScript name="JavaScript脚本1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="file_url"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=M3]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="file_name"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$$$]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[window.open(file_url,"下载文件")
// 写下载日志
_g().setCellValue(16, 1, "1");
_g().setCellValue(17, 1, file_name);
setTimeout(() => {
	_g().verifyAndWriteReport();
}, 100);]]></Content>
</JavaScript>
</NameJavaScript>
</NameJavaScriptGroup>
