<ReportWriteAttr>
<SubmitVisitor class="com.fr.report.write.BuiltInSQLSubmiter">
<Name>
<![CDATA[插入数据表]]></Name>
<Attributes dsName="common_db"/>
<DMLConfig class="com.fr.write.config.IntelliDMLConfig">
<Table schema="" name="ftp_file_record"/>
<ColumnConfig name="file_path_uuid" isKey="true" skipUnmodified="false">
<Parameter>
<Attributes name="file_path_uuid"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=UUID()]]></Attributes>
</O>
</Parameter>
</ColumnConfig>
<ColumnConfig name="file_dir" isKey="false" skipUnmodified="false">
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=CONCATENATE($file_upload_dir_new,"/",$busi_path,"/",$file_path_uuid,"/",FILENAME(K6))]]></Attributes>
</O>
</ColumnConfig>
<ColumnConfig name="file_url" isKey="false" skipUnmodified="false">
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=CONCATENATE($file_service_ip_new,"/",$busi_path,"/",$file_path_uuid,"/",FILENAME(K6))]]></Attributes>
</O>
</ColumnConfig>
<ColumnConfig name="file_name" isKey="true" skipUnmodified="false">
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=FILENAME(K6)]]></Attributes>
</O>
</ColumnConfig>
<ColumnConfig name="relative_path" isKey="false" skipUnmodified="false">
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=CONCATENATE("/",$busi_path,"/",$file_path_uuid,"/",FILENAME(K6))]]></Attributes>
</O>
</ColumnConfig>
<ColumnConfig name="file_source" isKey="false" skipUnmodified="false">
<O>
<![CDATA[1]]></O>
</ColumnConfig>
<ColumnConfig name="operator_oa" isKey="false" skipUnmodified="false">
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$fine_username]]></Attributes>
</O>
</ColumnConfig>
<ColumnConfig name="curr_status" isKey="false" skipUnmodified="false">
<O>
<![CDATA[1]]></O>
</ColumnConfig>
<Condition class="com.fr.data.condition.FormulaCondition">
<Formula>
<![CDATA[Q2 <> '1' && Q2 <> '2']]></Formula>
</Condition>
</DMLConfig>
</SubmitVisitor>
<SubmitVisitor class="com.fr.report.write.BuiltInSQLSubmiter">
