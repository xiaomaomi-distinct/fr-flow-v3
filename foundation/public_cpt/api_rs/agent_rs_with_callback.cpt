<WebPageContent>
<Listener event="afterload">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="paralist"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$paralist]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[var div = document.getElementById("newdiv");
var mask_div = window.parent.document.getElementById("mask_div");
div.remove();
//根据页面结果，若成功则刷新，否则不刷新
var rsdiv = document.getElementById("rs")
var rsMsg = document.getElementById("rsMsg")
//var successMsg = rsMsg.innerHTML + (!rsMsg.innerHTML || rsMsg.innerHTML.length == 0) ? "":"，";
if (rsdiv == null) {
	var rs = '失败！';
} else {
	var rs = rsdiv.textContent;
}

let needCountdown = FR.remoteEvaluate("=needCountdown");
if (rs == '成功！') {
	if (needCountdown == "1") {
		setTimeout(function() {
			var s = 3;
			rsMsg.innerHTML = s + '秒后，自动关闭页面!'
			window.myClose = setInterval(function() {
				s = --s;
				if (s <= 4) {
					rsMsg.innerHTML = s + '秒后，自动关闭页面!'
				}
				//		console.log(s);
				if (s == 0) {

					if (window.parent.successCallback && typeof window.parent.successCallback === "function") {
						window.parent.successCallback({
							subwindow: window
						});
					} else {
						window.parent.location.reload();
					}
					mask_div.remove();
					clearInterval(myClose);
				} else {}
			}, 1000)
		}, 0);
	}
} else {
	if (window.parent.failedCallback && typeof window.parent.failedCallback === "function") {
		mask_div.remove();
		window.parent.failedCallback({
			subwindow: window
		});
	}
}]]></Content>
</JavaScript>
</Listener>
<Listener event="startload">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="paralist"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=$paralist]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[var sHight = document.body.clientHeight * 0.3 + "px"
var aHight = document.body.clientHeight * 0.55 + "px"
var bHight = document.body.clientHeight * 0.65 + "px"
FR.HtmlLoader.loadingEffect=function(){}
var newdiv = document.createElement("div");
newdiv.id = "newdiv"
newdiv.style.top = '50%'
newdiv.innerHTML += '<div id="svgdiv" style="position:absolute;width: 100%; height: 60px; top: ' + sHight + '; left: 0px;text-align: center;line-height: 100px"><svg version="1.1" id="L4" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 40 180 180" enable-background="new 0 0 0 0" xml:space="preserve"><circle fill="#89c4f4" stroke="none" cx="65" cy="50" r="4"><animate attributeName="opacity" dur="1s" values="0;1;0" repeatCount="indefinite" begin="0.1"></animate></circle> <circle fill="#89c4f4" stroke="none" cx="77.5" cy="50" r="4"><animate attributeName="opacity" dur="1s" values="0;1;0" repeatCount="indefinite" begin="0.2"></animate></circle><circle fill="#89c4f4" stroke="none" cx="90" cy="50" r="4"><animate attributeName="opacity" dur="1s" values="0;1;0" repeatCount="indefinite" begin="0.3"></animate> </circle><circle fill="#89c4f4" stroke="none" cx="102.5" cy="50" r="4"><animate attributeName="opacity" dur="1s" values="0;1;0" repeatCount="indefinite" begin="0.4"></animate> </circle><circle fill="#89c4f4" stroke="none" cx="115" cy="50" r="4"><animate attributeName="opacity" dur="1s" values="0;1;0" repeatCount="indefinite" begin="0.5"></animate></circle></svg></div>' 
//newdiv.innerHTML += '<div id = "tipsA" style="position:absolute;width: 100%; height: 40px; top: ' + aHight + '; left: 0px;text-align: center; color: black; font-size:20px">正等待页面返回结果...</div>' 
//newdiv.innerHTML += '<div id = "tipsB" style="position:absolute;width: 100%; height: 40px; top: ' + bHight + '; left: 0px;text-align: center; color: orange; font-size:18px">结果返回前，请不要关闭页面</div>'

document.body.appendChild(newdiv)


/*增加遮蔽层 */
this.mask = document.createElement("div");
this.mask.style.width = window.parent.innerWidth + 'px'
this.mask.style.height = window.parent.innerHeight + 'px'
this.mask.style.background = '#fff'
this.mask.style.opacity = '.1'
this.mask.style.position = 'fixed'
this.mask.style.top = '0'
this.mask.style.left = '0'
this.mask.style.zIndex = '10086'
this.mask.id = 'mask_div'
window.parent.document.body.appendChild(this.mask)]]></Content>
</JavaScript>
</Listener>
