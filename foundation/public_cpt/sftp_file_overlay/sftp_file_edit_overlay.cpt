//	window.parent.FR.closeDialog();
//	return false;
//}]]></Content>
</JavaScript>
</Listener>
<Listener event="afterwrite">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[if (fr_submitinfo.success) {
	_g().parameterCommit();
	$(".fr-core-window-mask").remove()
	return false;
} else {
	window.parent.FR.Msg.alert("错误", fr_submitinfo.failinfo);
}]]></Content>
</JavaScript>
</Listener>
