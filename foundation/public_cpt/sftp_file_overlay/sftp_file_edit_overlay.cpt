<Content>
<![CDATA[if (file_path_uuid.length == 0 || typeof(file_path_uuid) == 'undefined') {
	window.parent.FR.Msg.alert("提示", "文件关联id为空，请联系信息科技部！");
	window.parent.FR.closeDialog();
	return false;
}

//if (busi_path.length == 0) {
