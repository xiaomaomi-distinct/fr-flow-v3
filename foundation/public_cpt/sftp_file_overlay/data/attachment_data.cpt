<TableDataMap>
<TableData name="attachment_qry" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="file_path_uuid"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[select a.id, a.file_path_uuid, a.file_url, a.file_name, a.relative_path, a.file_source, a.operator_oa, a.create_time, a.update_time from ftp_file_record a where a.file_path_uuid = '${file_path_uuid}' and a.curr_status = '1' order by a.update_time desc]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="attachment_delete" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="delete_id"/><O t="I"><![CDATA[0]]></O></Parameter><Parameter><Attributes name="operator_oa"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[CALL sp_attachment_delete(${delete_id}, '${operator_oa}')]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="attachment_delete_all" class="com.fr.data.impl.DBTableData"><Desensitizations desensitizeOpen="false"/><Parameters><Parameter><Attributes name="file_path_uuid"/><O><![CDATA[]]></O></Parameter><Parameter><Attributes name="operator_oa"/><O><![CDATA[]]></O></Parameter></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[common_db]]></DatabaseName></Connection><Query><![CDATA[CALL sp_attachment_delete_all('${file_path_uuid}', '${operator_oa}')]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData></TableDataMap>
